pipeline {
    agent any

    stages {

        stage('Install Dependencies') {
            steps {
                // Allow Jenkins to use the Flutter SDK repository
                bat 'git config --global --add safe.directory C:/src/flutter'

                // Get Flutter dependencies
                bat 'flutter pub get'
            }
        }

        stage('Analyze') {
            steps {
                bat 'flutter analyze'
            }
        }

        stage('Test') {
            steps {
                bat 'flutter test'
            }
        }

        stage('Build Web') {
            steps {
                bat 'flutter build web'
            }
        }

        stage('Archive Web') {
            steps {
                archiveArtifacts artifacts: 'build/web/**', allowEmptyArchive: false
            }
        }
    }

    post {
        success {
            echo 'Flutter pipeline completed successfully!'
        }

        failure {
            echo 'Flutter pipeline failed. Please check the stage above for the error.'
        }
    }
}